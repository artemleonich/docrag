# ===== DocRAG — переменные окружения (скопируйте в .env) =====

# --- Организация (подставляется в шапки .docx/.pptx и системный промпт) ---
DOCRAG_ORG_NAME=Организация
DOCRAG_ORG_FULL=Организация
DOCRAG_ORG_SITE=

# --- LLM (Ollama) ---
DOCRAG_LLM_BACKEND=ollama
DOCRAG_OLLAMA_HOST=http://localhost:11434
DOCRAG_LLM_MODEL=hf.co/t-tech/T-lite-it-2.1-GGUF:Q4_K_M
DOCRAG_LLM_NUM_CTX=8192
DOCRAG_LLM_TEMPERATURE=0.0

# --- Парсинг PDF ---
# pymupdf (по умолчанию) | docling (точное извлечение таблиц; нужен `uv sync --extra docling`,
# первая индексация скачает ML-модели). При сбое docling — авто-откат на pymupdf.
DOCRAG_PARSER=pymupdf

# --- Эмбеддинги / реранкер ---
DOCRAG_EMBED_MODEL=BAAI/bge-m3
DOCRAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
DOCRAG_EMBED_DEVICE=mps          # mps | cpu | cuda
DOCRAG_EMBED_USE_FP16=true

# --- Qdrant ---
DOCRAG_QDRANT_URL=http://localhost:16333
DOCRAG_QDRANT_COLLECTION=docrag_docs

# --- Ретрив ---
DOCRAG_RETRIEVE_TOP_K=50         # кандидатов из гибридного поиска
DOCRAG_RERANK_TOP_N=6            # сколько оставить после реранка
DOCRAG_HYBRID_DENSE_WEIGHT=0.5

# --- Скрейпер (опционально; по умолчанию источник PDF не задан) ---
DOCRAG_BASE_URL=                 # целевой домен-источник PDF
DOCRAG_SCRAPER_DELAY=3.0         # секунд между запросами

# --- Пути ---
DOCRAG_DATA_DIR=./data
